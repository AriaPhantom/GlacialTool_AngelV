<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProfessionVariant Condition="'$(ProfessionVariant)' == ''">NL</ProfessionVariant>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(ProfessionVariant)' == 'NL'">
    <ClCompile>
      <PreprocessorDefinitions>NL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(ProfessionVariant)' == 'Angel'">
    <ClCompile>
      <PreprocessorDefinitions>Angel;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(ProfessionVariant)' == 'Adele'">
    <ClCompile>
      <PreprocessorDefinitions>Adele;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <Target Name="ValidateProfessionVariant" BeforeTargets="PrepareForBuild"
          Condition="'$(ProfessionVariant)' != 'NL' and '$(ProfessionVariant)' != 'Angel' and '$(ProfessionVariant)' != 'Adele'">
    <Error Text="ProfessionVariant must be NL, Angel, or Adele; received '$(ProfessionVariant)'." />
  </Target>
</Project>
